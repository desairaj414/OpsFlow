# --- Secrets & environment ---
.env
.env.*
!.env.example

# .mcp.json can carry a raw API key/token in a --header value (e.g. `claude mcp add -s project`
# with an Authorization header) — project-scope MCP servers are meant to be git-shared config, but
# a literal secret should never end up there. Real credentials belong in local-scope MCP config
# (~/.claude.json, outside this repo) instead, same principle as .env above.
.mcp.json

# --- Python ---
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# --- Node / frontend ---
node_modules/
dist/
build/
.vite/

# --- Data / caches ---
data/*.db
backend/app.db
*.log

# data/chroma_db/ is intentionally committed (not ignored) — see render.yaml's backend build
# comment: the source data is frozen synthetic seed data, and rebuilding the Chroma index from
# scratch on every Render deploy means re-running ~700 embedding calls against Gemini's tightly
# rate-limited free tier, which is slow and can fail the build outright (real incident, 2026-08-13).
# Shipping the pre-built index instead makes deploys deterministic and quota-independent.

# --- OS/editor ---
.DS_Store
.vscode/*
!.vscode/settings.json

# --- Claude Code local state (machine-specific, not shared) ---
.claude/settings.local.json
.claude/scheduled_tasks.lock

# --- Explicitly KEEP (do not ignore) ---
!.knowledge/
!CLAUDE.md
!PRD_DRAFT.md
!PRD_FINAL.md
!token/
