# Copy this file to `.env` in the same folder (backend/.env) and fill in the real values.
# Never commit the real `.env` — it's already git-ignored.

# --- Multi-provider LLM (see backend/providers.py) ---
# Which provider a request uses when it sends no X-LLM-Provider header (pytest, smoke_test.py,
# scripts run outside a FastAPI request) — "gemini" for the public deploy, "tcs" for local dev
# against the original TCS gateway.
DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Only set to true when actually running on the TCS corporate network — enables the global SSL
# bypass config.py needs there (MITM proxy) and makes the `tcs` provider actually reachable.
# Leave false (default) for the public deploy.
TCS_NETWORK=false

# --- TCS GenAI Lab gateway (OpenAI-compatible) — legacy/gated `tcs` provider, TCS network only ---
BASE_URL=https://genailab.tcs.in/v1
API_KEY=your-gateway-api-key-here

# Comma-separated model ids issued in the event's Participant Handbook.
MODELS=azure/genailab-maas-gpt-4o-mini,azure_ai/genailab-maas-DeepSeek-R1,azure/genailab-maas-gpt-4.1-nano,azure/genailab-maas-whisper,azure/genailab-maas-gpt-4o,azure/genailab-maas-text-embedding-3-large

# Default chat/embedding models the running app uses day-to-day.
DEFAULT_CHAT_MODEL=azure/genailab-maas-gpt-4o-mini
DEFAULT_EMBED_MODEL=azure/genailab-maas-text-embedding-3-large

# --- Local Ollama offline fallback (used only if the gateway call above fails) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_FALLBACK_CHAT_MODEL=llama-3.2-3b-it
OLLAMA_FALLBACK_EMBED_MODEL=gte-large

# --- CORS: must match the URL the frontend actually runs on ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Mock JWT auth (this project uses a simulated login, not a real identity provider) ---
JWT_SECRET=change-me-to-any-random-string
JWT_EXPIRE_MINUTES=60

# --- A2A Agent Card signing (Supervisor -> Diagnosis handoff) ---
A2A_SECRET=change-me-to-any-random-string
