# Copy this file to `.env.local` in the same folder (frontend/.env.local) — Next.js loads it
# automatically. Never commit the real `.env.local` (already covered by frontend/.gitignore).

# Base URL of the FastAPI backend. Defaults to http://localhost:8765 if unset (see
# frontend/src/app/page.js) — only needs to be set explicitly for a non-default local port, or to
# point a deployed frontend (Vercel) at a deployed backend (Render).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8765
